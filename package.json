{
  "name": "jugaadtv-iptv",
  "version": "1.0.0",
  "private": true,
  "description": "A local IPTV web player with React, Express, M3U upload, favorites, history, and admin tools.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:server\" \"npm:vite\"",
    "server": "node backend/server.js",
    "vite": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node backend/server.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "hls.js": "^1.6.15",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "vite": "^7.1.7"
  }
}
